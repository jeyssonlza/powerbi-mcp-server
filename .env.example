# ===========================================================================
# Power BI MCP Server - Variables de entorno (EJEMPLO)
# Copia este archivo a ".env" y completa los valores reales.
# NUNCA subas el archivo .env real al repositorio.
# ===========================================================================

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
PBIMCP_LOG_LEVEL=INFO
# Carpeta donde se guardan los logs
PBIMCP_LOG_DIR=logs
# Carpeta raiz por defecto donde estan los proyectos PBIP (opcional)
PBIMCP_WORKSPACE_DIR=

# ---------------------------------------------------------------------------
# Respaldos automaticos
# ---------------------------------------------------------------------------
# Activar respaldo antes de cada escritura (recomendado: true)
PBIMCP_BACKUP_ENABLED=true
# Carpeta de respaldos
PBIMCP_BACKUP_DIR=.pbip_backups
# Numero maximo de respaldos a conservar por proyecto (0 = ilimitado)
PBIMCP_BACKUP_MAX=50
# Encriptar respaldos (requiere PBIMCP_SECRET_KEY)
PBIMCP_BACKUP_ENCRYPT=false

# ---------------------------------------------------------------------------
# Seguridad / Encriptacion
# ---------------------------------------------------------------------------
# Clave maestra para encriptacion (Fernet/AES). Genera una con:
#   python -m powerbi_mcp.security.encryption --generate-key
PBIMCP_SECRET_KEY=
# Salt para hashing de claves subrogadas (cualquier cadena larga y secreta)
PBIMCP_SURROGATE_SALT=

# ---------------------------------------------------------------------------
# Power BI Service - REST API (opcional)
# Registro de app: https://portal.azure.com -> App registrations
# ---------------------------------------------------------------------------
# ID de inquilino (Directory / Tenant ID)
PBIMCP_AZURE_TENANT_ID=
# ID de la aplicacion (Client / Application ID)
PBIMCP_AZURE_CLIENT_ID=
# Secreto de cliente (solo para flujo service principal)
PBIMCP_AZURE_CLIENT_SECRET=
# Scopes (por defecto Power BI)
PBIMCP_AZURE_SCOPES=https://analysis.windows.net/powerbi/api/.default

# ---------------------------------------------------------------------------
# Analysis Services local (opcional - validacion semantica DAX profunda)
# ---------------------------------------------------------------------------
# Cadena de conexion a un AS/Power BI Desktop local (XMLA)
PBIMCP_AS_CONNECTION_STRING=
