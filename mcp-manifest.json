{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/registry/main/schema/manifest.json",
  "name": "powerbi-mcp-server",
  "displayName": "Power BI MCP Server",
  "version": "0.1.0",
  "description": "Professional MCP server for Power BI automation — 66 tools for PBIP/PBIX project management, semantic-model analysis & DAX validation, AI/ML analytics, visualization, documentation, security, and Power BI Service integration.",
  "author": {
    "name": "Jeysson Zerpa",
    "email": "jeyssonzerpa@gmail.com",
    "url": "https://github.com/jeyssonlza"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeyssonlza/powerbi-mcp-server"
  },
  "homepage": "https://github.com/jeyssonlza/powerbi-mcp-server",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "power-bi",
    "pbip",
    "pbix",
    "mcp",
    "model-context-protocol",
    "dax",
    "data-modeling",
    "business-intelligence",
    "ai",
    "machine-learning",
    "analytics",
    "microsoft",
    "data-science"
  ],
  "categories": [
    "Data & Analytics",
    "Business Intelligence",
    "Microsoft 365",
    "AI & ML"
  ],
  "runtime": {
    "type": "python",
    "version": ">=3.10",
    "install": "pip install powerbi-mcp-server",
    "command": "powerbi-mcp"
  },
  "docker": {
    "image": "jeyssonlza/powerbi-mcp-server",
    "tag": "0.1.0",
    "compose": "docker-compose.yml"
  },
  "configuration": {
    "required": [],
    "optional": [
      {
        "name": "POWERBI_TENANT_ID",
        "description": "Azure AD Tenant ID for Power BI Service API",
        "type": "string",
        "secret": false
      },
      {
        "name": "POWERBI_CLIENT_ID",
        "description": "Azure AD Application (client) ID",
        "type": "string",
        "secret": false
      },
      {
        "name": "POWERBI_CLIENT_SECRET",
        "description": "Azure AD Client Secret for OAuth2 authentication",
        "type": "string",
        "secret": true
      },
      {
        "name": "POWERBI_PROJECT_DIR",
        "description": "Default directory for Power BI projects",
        "type": "string",
        "default": "./projects"
      }
    ]
  },
  "tools": {
    "total": 66,
    "domains": [
      {
        "name": "project",
        "count": 10,
        "description": "PBIP/PBIX project lifecycle: open, inspect, reload, close, backup, restore and PBIX conversion",
        "tools": [
          "open_project", "project_info", "project_structure", "reload_project", "close_project",
          "list_backups", "create_backup", "restore_backup", "convert_to_pbix", "read_pbix_info"
        ]
      },
      {
        "name": "model",
        "count": 22,
        "description": "Semantic model authoring: tables, columns, measures, relationships, DAX validation and schema classification",
        "tools": [
          "list_tables", "describe_table", "list_measures", "list_relationships", "search_objects",
          "add_table", "add_calculated_table", "rename_table", "delete_table",
          "add_data_column", "add_calculated_column", "update_column", "delete_column",
          "add_measure", "update_measure", "delete_measure", "validate_dax",
          "add_relationship", "update_relationship", "delete_relationship", "diagnose_relationships",
          "classify_schema"
        ]
      },
      {
        "name": "ai",
        "count": 8,
        "description": "AI/ML analytics: anomaly detection, clustering, forecasting, RFM segmentation, correlation and model training",
        "tools": [
          "detect_anomalies", "run_clustering", "forecast_series", "rfm_segmentation",
          "correlation_analysis", "decision_tree_explain", "train_regression", "train_classification"
        ]
      },
      {
        "name": "visuals",
        "count": 7,
        "description": "Report pages, visuals, dashboards, HTML export and theming",
        "tools": [
          "list_pages", "create_page", "create_visual", "create_dashboard",
          "export_html_visual", "list_color_palettes", "create_theme"
        ]
      },
      {
        "name": "analysis",
        "count": 5,
        "description": "Data quality, profiling, performance analysis, best practices and DAX optimization",
        "tools": [
          "analyze_data_quality", "profile_data", "analyze_performance",
          "run_best_practices", "optimize_dax"
        ]
      },
      {
        "name": "docs",
        "count": 3,
        "description": "Automated documentation, data dictionary and changelog generation",
        "tools": ["generate_documentation", "generate_data_dictionary", "get_changelog"]
      },
      {
        "name": "security",
        "count": 6,
        "description": "PII masking, surrogate keys, value encryption/decryption and audit logging",
        "tools": [
          "mask_data", "generate_surrogate_keys", "encrypt_value", "decrypt_value",
          "generate_encryption_key", "get_audit_log"
        ]
      },
      {
        "name": "pbi_api",
        "count": 5,
        "description": "Power BI Service REST API: workspaces, datasets, reports, DAX execution and dataset refresh",
        "tools": [
          "pbi_list_workspaces", "pbi_list_datasets", "pbi_list_reports",
          "pbi_execute_dax", "pbi_refresh_dataset"
        ]
      }
    ]
  },
  "compatibility": {
    "claude": ">=3.0",
    "mcp": ">=1.2.0"
  }
}
